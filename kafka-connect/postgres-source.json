{
  "name": "flowfleet-postgres-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "flowfleet",
    "database.password": "flowfleet",
    "database.dbname": "flowfleet",

    "plugin.name": "pgoutput",
    "slot.name": "flowfleet_debezium",
    "publication.name": "flowfleet_pub",
    "publication.autocreate.mode": "filtered",

    "topic.prefix": "flowfleet",
    "table.include.list": "public.orders,public.order_items,public.drivers,public.deliveries,public.driver_shifts",

    "snapshot.mode": "initial",
    "tombstones.on.delete": "true",
    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "10000",

    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8085",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8085",

    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "flowfleet\\.public\\.(.*)",
    "transforms.route.replacement": "flowfleet.$1.cdc",

    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "12",
    "topic.creation.default.cleanup.policy": "delete",
    "topic.creation.default.retention.ms": "604800000"
  }
}
